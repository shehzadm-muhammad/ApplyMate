# ==========================================
# Local development
# Copy this file to backend/.env
# Never commit backend/.env
# ==========================================

POSTGRES_DB=applymate
POSTGRES_USER=applymate
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432

JWT_SECRET=replace_with_base64_encoded_32_byte_secret

EMAIL_VERIFICATION_PEPPER=replace_with_base64_encoded_32_byte_secret
PASSWORD_RESET_PEPPER=replace_with_a_different_base64_encoded_32_byte_secret


APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://127.0.0.1:[*]

# ==========================================
# Production deployment
#
# Set these through the hosting platform's
# environment-variable settings.
#
# Do not uncomment these in the local .env
# file unless intentionally testing the
# production profile locally.
#
# Transactional email is disabled locally unless intentionally configured.
EMAIL_PROVIDER=disabled

# Required only when EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace_with_resend_api_key
# EMAIL_FROM=ApplyMate <verify@your-domain.example>

# Optional provider timeout tuning
# EMAIL_CONNECT_TIMEOUT=PT5S
# EMAIL_READ_TIMEOUT=PT10S
# ==========================================

# SPRING_PROFILES_ACTIVE=prod
# PORT=8080

# DB_URL=jdbc:postgresql://database-host:5432/applymate
# DB_USERNAME=applymate
# DB_PASSWORD=replace_with_production_password

# JWT_SECRET=replace_with_production_base64_secret

# EMAIL_VERIFICATION_PEPPER=replace_with_production_base64_secret
# PASSWORD_RESET_PEPPER=replace_with_a_different_production_base64_secret

# EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace_with_production_resend_api_key
# EMAIL_FROM=ApplyMate <verify@your-verified-domain.example>

# APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-production-origin.example

# Optional database-pool tuning
# DB_MAX_POOL_SIZE=10
# DB_MIN_IDLE=1
# DB_CONNECTION_TIMEOUT_MS=30000
# DB_MAX_LIFETIME_MS=1800000